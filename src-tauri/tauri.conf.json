{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CCBaga-A",
  "version": "0.2.0",
  "identifier": "ai.local.requirement-french",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build && sh scripts/package-browser.sh",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CCBaga-A",
        "width": 1040,
        "height": 820,
        "minWidth": 760,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#FFFFFF"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "resources": {
      "../dist/": "browser-ui/",
      "../browser-runtime/version.txt": "browser-runtime/version.txt",
      "../browser-runtime/LICENSE.fingerprint-chromium": "browser-runtime/LICENSE.fingerprint-chromium",
      "../assets/ai-icons/LICENSE.lobehub.txt": "licenses/LICENSE.lobehub.txt",
      "../vendor/glib/LICENSE": "licenses/LICENSE.glib.txt"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/liseami/CCBaga/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJEQjVDMDk0RkU1ODBCQzUKUldURkMxaitsTUMxTFlYajNuTFBvK3EzeG5ubGpFK1VyZmZ6QnVJYnhERi9ta05sV0pRc2E3TXIK",
      "requireSignedVersion": true
    }
  }
}
